#!/bin/sh
### BEGIN INIT INFO
# Provides:          gnome-session
# Required-Start:    $local_fs dbus
# Default-Start:     5
# Default-Stop:      0 1 6
# Short-Description: GNOME Session
### END INIT INFO

case "$1" in
  start)
    echo "Starting gnome-session components"
    # Handled primarily by aw-userd + spoofd
    ;;
  stop)
    echo "Stopping gnome-session"
    ;;
  *)
    echo "Usage: $0 {start|stop}"
    ;;
esac
exit 0
