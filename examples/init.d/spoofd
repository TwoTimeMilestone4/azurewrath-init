#!/bin/sh
### BEGIN INIT INFO
# Provides:          spoofd
# Required-Start:    $local_fs dbus
# Required-Stop:     $local_fs
# Default-Start:     5
# Default-Stop:      0 1 6
# Short-Description: azurewrath systemd spoof daemon
### END INIT INFO

# Author: TwoTimeMilestone4

NAME=aw-spoofd
DAEMON=/usr/sbin/aw-spoofd
PIDFILE=/run/$NAME.pid

case "$1" in
  start)
    echo "Starting $NAME"
    start-stop-daemon --start --quiet --pidfile $PIDFILE --make-pidfile \
      --background --exec $DAEMON
    ;;
  stop)
    echo "Stopping $NAME"
    start-stop-daemon --stop --quiet --pidfile $PIDFILE
    rm -f $PIDFILE
    ;;
  restart)
    $0 stop
    $0 start
    ;;
  status)
    if [ -f $PIDFILE ] && kill -0 $(cat $PIDFILE) 2>/dev/null; then
      echo "$NAME is running"
    else
      echo "$NAME is stopped"
    fi
    ;;
esac
exit 0
